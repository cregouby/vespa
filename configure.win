#!/bin/sh
# configure.win -- revision tarball-static-v3
set -e
UCRT="C:/rtools45/ucrt64"

# --- Vespa statique : bundle inst/vespa, sinon $VESPA_ROOT -------------------
if [ -f "inst/vespa/include/vtkCGALAlgorithm.h" ]; then
  FOUND_ROOT="$(pwd)/inst/vespa"
elif [ -n "${VESPA_ROOT}" ] && [ -f "${VESPA_ROOT}/include/vtkCGALAlgorithm.h" ]; then
  FOUND_ROOT="${VESPA_ROOT}"
else
  echo ">> ERROR: Vespa introuvable (inst/vespa ou \$VESPA_ROOT)" >&2; exit 1
fi

VESPA_LIBS=""
for f in "${FOUND_ROOT}"/lib/libvtkCGAL*.a; do
  [ -e "$f" ] || continue
  VESPA_LIBS="${VESPA_LIBS} $f"
done
[ -n "${VESPA_LIBS}" ] || { echo ">> ERROR: pas de libvtkCGAL*.a (rebuild vespa en BUILD_SHARED_LIBS=OFF)" >&2; exit 1; }

# --- VTK : tarball préconstruit, branche statique uniquement -----------------
[ -n "${VTK_ROOT}" ] || { echo ">> ERROR: VTK_ROOT vide" >&2; exit 1; }
VTK_INCDIR="$(echo "${VTK_ROOT}"/include/vtk-*/vtkObject.h | sed 's|/vtkObject.h||')"
[ -f "${VTK_INCDIR}/vtkObject.h" ] || { echo ">> ERROR: VTK invalide sous ${VTK_ROOT}" >&2; exit 1; }
VTK_ARCHIVES=""
for a in "${VTK_ROOT}"/lib/libvtk*.a; do
  [ -e "$a" ] || continue
  VTK_ARCHIVES="${VTK_ARCHIVES} $a"
done
[ -n "${VTK_ARCHIVES}" ] || { echo ">> ERROR: pas de libvtk*.a sous ${VTK_ROOT}/lib" >&2; exit 1; }

# --- headers tiers requis par vtkCGAL*.h : CGAL, Eigen, Boost ---------------
EXTRA_CPPFLAGS="-I${UCRT}/include -I${UCRT}/include/eigen3"
EXPORT_FLAGS="-DVTKCGALALGORITHM_EXPORT= -DVTKCGALPMP_EXPORT= -DVTKCGALPSP_EXPORT= -DVTKCGALSR_EXPORT= -DVTKCGALDELAUNAY_EXPORT="

# --- clôture de link : ceres (+ suitesparse transitif), gmp, mpfr, system ---
if command -v pkg-config >/dev/null 2>&1 && pkg-config --libs ceres >/dev/null 2>&1; then
  CERES_LIBS=$(pkg-config --libs ceres)
else
  CERES_LIBS="-lceres -lcholmod -lamd -lcamd -lccolamd -lcolamd -lsuitesparseconfig -lspqr -lmetis -llapack -lblas"
fi
SYSTEM_LIBS="-lopengl32 -lglu32 -lws2_32 -liphlpapi -lpsapi -ldbghelp -luser32 -lgdi32 -ladvapi32 -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -lkernel32"

cat > src/Makevars.win <<EOF
# Generated by configure.win (tarball-static-v3) -- do not edit.
PKG_CPPFLAGS = -isystem ${VTK_INCDIR} -I${FOUND_ROOT}/include ${EXTRA_CPPFLAGS} ${EXPORT_FLAGS}
PKG_LIBS = -Wl,--start-group ${VESPA_LIBS} ${VTK_ARCHIVES} -Wl,--end-group -L${UCRT}/lib ${CERES_LIBS} -lgmp -lmpfr ${SYSTEM_LIBS}
EOF

echo ">> Configuration completed successfully."