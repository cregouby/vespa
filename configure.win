#!/bin/sh
# configure.win -- use bundled Vespa binaries (no system dependencies required)

echo ">> configure.win: using bundled Vespa binaries"

# VESPA_ROOT is always the bundled location
VESPA_ROOT="$(pwd)/inst/vespa"

if [ ! -d "${VESPA_ROOT}/include" ]; then
  echo ">> ERROR: bundled Vespa binaries not found in inst/vespa/" >&2
  exit 1
fi

# Collect static libraries
VESPA_LIBS=""
for f in "${VESPA_ROOT}"/lib/lib*.a; do
  [ -e "${f}" ] || continue
  n="${f##*/}"; n="${n%.a}"
  VESPA_LIBS="${VESPA_LIBS} -l${n#lib}"
done

echo ">> Vespa libs: ${VESPA_LIBS}"

# Generate Makevars.win
cat > src/Makevars.win <<EOF
# Generated by configure.win -- do not edit.
PKG_CPPFLAGS = -I"${VESPA_ROOT}/include"
PKG_LIBS = -L"${VESPA_ROOT}/lib" ${VESPA_LIBS}
EOF

echo ">> Configuration completed successfully."