#!/bin/sh
# configure.win -- Windows configuration for the vespa R package.
# Revision: bundled-v1
#   * VTK flags come from rvtk (prebuilt static libs, downloaded automatically).
#   * Vespa binaries ship with the package under inst/vespa (include/ + lib/,
#     plus bin/ when built in shared mode); VESPA_ROOT may override the
#     location (used by CI).
#   * No user-facing install instructions: everything needed is bundled or
#     fetched by rvtk.

echo ">> EXECUTING configure.win from $(pwd)"
echo ">> configure.win revision: bundled-v1"

# --- Early validation of rvtk (real flags are injected at make time) ---
if ! "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --vanilla tools/configure.R --cppflags > /dev/null 2>&1; then
  echo ">> ERROR: rvtk could not resolve a VTK installation." >&2
  exit 1
fi
echo ">> VTK flags will be provided by rvtk at make time."

# --- Locate Vespa binaries: env override first, then bundled copy ---
if [ -z "${VESPA_ROOT}" ]; then
  if [ -d "inst/vespa" ]; then
    VESPA_ROOT="$(pwd)/inst/vespa"
    echo ">> Using Vespa binaries bundled in inst/vespa"
  fi
fi
if [ -z "${VESPA_ROOT}" ] || [ ! -d "${VESPA_ROOT}/include" ]; then
  echo ">> ERROR: no Vespa installation found (looked in inst/vespa and \$VESPA_ROOT)." >&2
  exit 1
fi
echo ">> VESPA_ROOT: ${VESPA_ROOT}"

# --- Collect Vespa libraries ---
# Import libraries (lib*.dll.a) mean shared mode: the DLLs must be reachable
# at run time (see the .onLoad PATH hook in R/zzz.R). Plain static libs
# (lib*.a) are embedded directly into vespa.dll.
VESPA_LIBS=""
VESPA_SHARED=false
for f in "${VESPA_ROOT}"/lib/lib*.dll.a; do
  [ -e "${f}" ] || continue
  n="${f##*/}"; n="${n%.dll.a}"
  VESPA_LIBS="${VESPA_LIBS} -l${n#lib}"
  VESPA_SHARED=true
done
if [ -z "${VESPA_LIBS}" ]; then
  for f in "${VESPA_ROOT}"/lib/lib*.a; do
    [ -e "${f}" ] || continue
    n="${f##*/}"; n="${n%.a}"
    VESPA_LIBS="${VESPA_LIBS} -l${n#lib}"
  done
fi
if [ -z "${VESPA_LIBS}" ]; then
  echo ">> ERROR: no Vespa libraries found in ${VESPA_ROOT}/lib" >&2
  exit 1
fi
echo ">> Vespa libs:${VESPA_LIBS} (shared=${VESPA_SHARED})"

# --- Include dirs: bundled headers first, Rtools sysroot as fallback ---
EXTRA_INC=""
if [ -d "${VESPA_ROOT}/include/eigen3" ]; then
  EXTRA_INC=" -I${VESPA_ROOT}/include/eigen3"
fi

UCRT64=""
if [ -n "${RTOOLS45_HOME}" ] && [ -d "${RTOOLS45_HOME}/ucrt64" ]; then
  UCRT64="${RTOOLS45_HOME}/ucrt64"
elif [ -d "/ucrt64" ]; then
  UCRT64="/ucrt64"
elif [ -d "C:/rtools45/ucrt64" ]; then
  UCRT64="C:/rtools45/ucrt64"
fi

# Ceres/GMP/MPFR: use bundled copies when present, else the Rtools sysroot
# (available on CI runners with pacman packages installed).
THIRD_PARTY_INC=""
THIRD_PARTY_LIBS=""
if [ ! -e "${VESPA_ROOT}/lib/libceres.a" ] && [ ! -e "${VESPA_ROOT}/lib/libceres.dll.a" ]; then
  if [ -n "${UCRT64}" ]; then
    THIRD_PARTY_INC=" -I${UCRT64}/include -I${UCRT64}/include/eigen3"
    THIRD_PARTY_LIBS=" -L${UCRT64}/lib -lceres -lgmp -lmpfr"
  else
    echo ">> ERROR: Ceres not bundled and no Rtools ucrt64 sysroot found." >&2
    exit 1
  fi
fi

# --- Generate Makevars.win ---
echo ">> Generating src/Makevars.win..."
cat > src/Makevars.win <<EOF
# Generated by configure.win -- do not edit.
VTK_CPPFLAGS = \$(shell "\$(R_HOME)/bin\$(R_ARCH_BIN)/Rscript" --vanilla ../tools/configure.R --cppflags)
VTK_LIBS     = \$(shell "\$(R_HOME)/bin\$(R_ARCH_BIN)/Rscript" --vanilla ../tools/configure.R --libs)

PKG_CPPFLAGS = \$(VTK_CPPFLAGS) -I${VESPA_ROOT}/include${EXTRA_INC}${THIRD_PARTY_INC}
PKG_LIBS     = \$(VTK_LIBS) -L${VESPA_ROOT}/lib ${VESPA_LIBS}${THIRD_PARTY_LIBS}
EOF

echo ">> Configuration completed successfully."