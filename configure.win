#!/bin/sh
# configure.win -- use bundled Vespa binaries (no system dependencies required)

echo ">> configure.win: using bundled Vespa binaries"

# VESPA_ROOT is always the bundled location
VESPA_ROOT="$(pwd)/inst/vespa"

if [ ! -d "${VESPA_ROOT}/include" ]; then
  echo ">> ERROR: bundled Vespa binaries not found in inst/vespa/" >&2
  exit 1
fi

# Look for bundled Vespa binaries
VESPA_ROOT=""
if [ -d "inst/vespa/include" ]; then
  VESPA_ROOT="$(pwd)/inst/vespa"
  echo ">> Using Vespa binaries bundled in inst/vespa"
elif [ -n "${VESPA_ROOT}" ] && [ -d "${VESPA_ROOT}/include" ]; then
  echo ">> Using VESPA_ROOT=${VESPA_ROOT}"
else
  echo ">> ERROR: no Vespa installation found." >&2
  echo ">> Expected: inst/vespa/include (bundled) or \$VESPA_ROOT environment variable" >&2
  exit 1
fi

# Collect import libraries (Windows uses .dll.a for shared libs)
VESPA_LIBS=""
for f in "${VESPA_ROOT}"/lib/lib*.dll.a; do
  [ -e "${f}" ] || continue
  n="${f##*/}"; n="${n%.dll.a}"
  VESPA_LIBS="${VESPA_LIBS} -l${n#lib}"
done

if [ -z "${VESPA_LIBS}" ]; then
  echo ">> ERROR: no Vespa libraries found in ${VESPA_ROOT}/lib" >&2
  exit 1
fi


echo ">> Vespa libs: ${VESPA_LIBS}"

# Generate Makevars.win
cat > src/Makevars.win <<EOF
VTK_CPPFLAGS = \$(shell "\$(R_HOME)/bin\$(R_ARCH_BIN)/Rscript" --vanilla ../tools/configure.R --cppflags)
VTK_LIBS     = \$(shell "\$(R_HOME)/bin\$(R_ARCH_BIN)/Rscript" --vanilla ../tools/configure.R --libs)

PKG_CPPFLAGS = \$(VTK_CPPFLAGS) -I${VESPA_ROOT}/include
PKG_LIBS     = \$(VTK_LIBS) -L${VESPA_ROOT}/lib ${VESPA_LIBS}
EOF


echo ">> Configuration completed successfully."