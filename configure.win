#!/bin/sh
# configure.win -- génère src/Makevars.win pour le toolchain Rtools/MinGW.

# Debug: afficher les variables d'environnement reçues
echo ">> configure.win: VTK_ROOT=${VTK_ROOT}"
echo ">> configure.win: VESPA_ROOT=${VESPA_ROOT}"

# Valeurs par défaut
: "${VTK_ROOT:=D:/a/vtk-9.4}"
: "${VESPA_ROOT:=D:/a/vespa}"
: "${UCRT64:=C:/rtools45/ucrt64}"

# Vérifier que le répertoire include existe
VTK_INCLUDE="${VTK_ROOT}/include"
if [ ! -d "${VTK_INCLUDE}" ]; then
  echo ">> ERROR: VTK include directory does not exist: ${VTK_INCLUDE}" >&2
  exit 1
fi

echo ">> VTK include directory exists: ${VTK_INCLUDE}"
echo ">> Listing contents:"
ls -la "${VTK_INCLUDE}" 2>&1 | head -20

# Trouver le sous-répertoire vtk-X.Y (méthode robuste)
VTK_INCDIR=""
for dir in "${VTK_INCLUDE}"/vtk-*; do
  if [ -d "${dir}" ]; then
    VTK_INCDIR="${dir}"
    echo ">> Found VTK headers: ${VTK_INCDIR}"
    break
  fi
done

if [ -z "${VTK_INCDIR}" ]; then
  echo ">> ERROR: No vtk-* subdirectory found under ${VTK_INCLUDE}" >&2
  echo ">> Attempting to list all subdirectories:" >&2
  find "${VTK_INCLUDE}" -maxdepth 1 -type d 2>&1 >&2
  exit 1
fi

echo ">> Found Vespa in ${VESPA_ROOT}"
echo ">> Generating src/Makevars.win..."

cat > src/Makevars.win <<EOF
PKG_CPPFLAGS = -I"${VTK_INCDIR}" -I"${VESPA_ROOT}/include" -I"${UCRT64}/include" -I"${UCRT64}/include/eigen3"
PKG_LIBS = -L"${VESPA_ROOT}/lib" -lvtkCGALAlgorithm -lvtkCGALPMP -lvtkCGALDelaunay -lvtkCGALPSP -lvtkCGALSR -L"${VTK_ROOT}/lib" -lvtkCommonCore-9.4 -lvtkCommonDataModel-9.4 -lvtkCommonExecutionModel-9.4 -lvtkFiltersCore-9.4 -lvtkFiltersExtraction-9.4 -lvtkFiltersGeometry-9.4 -lvtkFiltersGeneral-9.4 -lvtkFiltersModeling-9.4 -lvtkFiltersPoints-9.4 -lvtkIOGeometry-9.4 -lvtkIOXML-9.4 -lvtkIOCore-9.4 -lvtkIOLegacy-9.4 -lvtkImagingCore-9.4 -lvtkImagingStencil-9.4 -L"${UCRT64}/lib" -lceres -lgmp -lmpfr
EOF

echo ">> Configuration completed successfully."