CXX_STD = CXX17

VTK_CPPFLAGS = $(shell "$(R_HOME)/bin/Rscript" --vanilla ../tools/configure.R --cppflags)
VTK_LIBS     = $(shell "$(R_HOME)/bin/Rscript" --vanilla ../tools/configure.R --libs)

PKG_CPPFLAGS = \
   $(VTK_CPPFLAGS) \
  -I"@VESPA_INC@" \
  -I"@CGAL_INC@" \
  @CERES_CFLAGS@

PKG_LIBS = \
	$(VTK_LIBS) \
  -L"@VESPA_LIBDIR@" \
  -lvtkCGALAlgorithm \
  -lvtkCGALPMP \
  -lvtkCGALDelaunay \
  -lvtkCGALPSP \
  -lvtkCGALSR \
  @CERES_LIBS@ \
  -Wl,-rpath,"@VTK_LIBDIR@" \
  -Wl,-rpath,"@VESPA_RPATH@"