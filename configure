#!/bin/sh
# configure -- Unix/macOS configuration for the vespa R package.
# Revision: tarball-static-v9.1
# v9.1 :
#  - v9 introduced the libvtk* archive version filter (stale mixed-version
#    bundles must never enter the link line) but VTK_MINOR was only set in
#    the "downloaded" branch. With VTK_ROOT (workflow prebuilt prefix) it
#    stayed empty and the pattern degenerated to *-.a: NO archive matched
#    and configure aborted with "no libvtk*.a found" on Ubuntu AND macOS.
#    VTK_MINOR is now derived from VTK_VERSION in BOTH prebuilt and
#    download strategies, cut down to its first two components ("9.6")
#    so it matches archive names like libvtkCommonCore-9.6.a as well as
#    bundles whose include dir is vtk-9.6 rather than vtk-9.6.2.
#  - (paired configure.win fix) rtools45 pkg-config ceres.pc lists
#    -lmetis while ucrt64/lib ships no metis archive: -lmetis is now
#    stripped from CERES_LIBS whenever the archive is absent, whichever
#    code path produced it (pkg-config or the manual suitesparse closure).
# v8 :
#  - v7 attempted -Wl,--exclude-libs,ALL: it only makes symbols coming FROM
#    STATIC ARCHIVES local. The Rcpp/vtkCGAL wrapper objects also DEFINE
#    exported VTK symbols (template instantiations, inlined functions,
#    vtables/typeinfo) and those remained exported.
#  - R dlopen()s packages with RTLD_GLOBAL: every exported vespa.so symbol
#    lands in the flat process namespace next to rvtk.so (own static VTK,
#    loaded earlier). rvtk's weak definitions then interpose with vespa's,
#    mixing two VTK builds inside one process -> segfaults in delaunay2 /
#    advancing_front / testthat (PoC interposition matrix A/B/C/D proved the
#    mechanism; the no-R repro exonerated the static libraries themselves).
#  - FIX: linker version script exporting ONLY R_init_vespa and making ALL
#    other symbols local (archives AND wrapper objects). Rcpp registration
#    (R_useDynamicSymbols(FALSE) set at init) means no other symbol needs
#    dynamic visibility. Linux: -Wl,--version-script (GNU ld/lld/gold);
#    macOS: -Wl,-exported_symbols_list; Windows: PE has no flat namespace,
#    nothing to do (configure.win keeps --exclude-libs,ALL as hygiene).
# v6 :
#  - FIX (real local R CMD check, Ubuntu/GCC 13): the header
#    marker vtkCGALAlgorithm.h does NOT exist in the Kitware vespa install
#    layout. The superbuild installs FLAT headers -- vtkCGALPolyDataAlgorithm.h
#    (base class of every filter), vtkCGALHelper.h -- plus per-module headers
#    such as vtkCGALAlgorithmModule.h. A successful auto-build was therefore
#    rejected by its own post-build re-check (VESPA_INC stayed empty).
#    Detection now uses vtkCGALPolyDataAlgorithm.h / vtkCGALHelper.h, flat
#    or one level deep.
#  - FIX: Priority 1 (bundled inst/vespa) accepts STATIC archives too (the
#    whole strategy is static), not just .so/.dylib.
#  - FIX: *.dll.a Windows import libraries are ignored everywhere (a stale
#    Windows bundle extracted into inst/vespa must not poison a Unix build).
#  - FIX: auto_build_vespa wipes inst/vespa before building so stale zips,
#    old *.dll.a or partial installs cannot poison the post-build check.
#  - FIX: removed the two lines that overwrote VTK_CPPFLAGS/VTK_LIBS with
#    inst/vtk paths that do not exist in CI.
#  - FIX: Strategy 2 (download) now sets VTK_INCDIR/VTK_LIBDIR.
#  - FIX: auto_build_vespa passes VTK_ROOT to the superbuild and stays
#    static (the superbuild requires VTK_ROOT; -DBUILD_SHARED_LIBS=ON
#    alone would hit a CMake FATAL_ERROR).
#  - FIX: Vespa detection hardened: the header marker is searched FLAT
#    (include/) AND one level deep (include/*/), lib/ and lib64/ both
#    accepted. The exact install layout of the Kitware vespa project has
#    never been exercised in CI before, so detection must not depend on a
#    single guess.
#  - FIX: full diagnostics dumped when Vespa is still not found.

print_install_instructions() {
  echo ""
  echo "========================================================================"
  echo " ERROR: Missing system dependencies for Vespa R package"
  echo "========================================================================"
  echo ""
  echo "This package requires CGAL, Ceres Solver, and Eigen."
  echo "VTK is provided at install time by the 'rvtk' R package."
  echo "The Vespa C++ sources are bundled with this package."
  echo ""
  echo "1. CGAL, Ceres, and Eigen can be installed via your package manager:"

  if [ "$(uname)" = "Darwin" ]; then
    echo "   On macOS (using Homebrew):"
    echo "     brew install cgal ceres-solver eigen"
  elif [ -f /etc/debian_version ] || grep -qi "ubuntu" /etc/issue; then
    echo "   On Debian / Ubuntu:"
    echo "     sudo apt-get update"
    echo "     sudo apt-get install libcgal-dev libceres-dev libeigen3-dev"
  elif [ -f /etc/redhat-release ] || [ -f /etc/fedora-release ]; then
    echo "   On Fedora / RHEL / CentOS:"
    echo "     sudo dnf install CGAL-devel ceres-solver-devel eigen3-devel"
  else
    echo "   On Linux, install the development packages for CGAL, Ceres, and Eigen."
  fi

  echo ""
  echo "2. The bundled Vespa sources are compiled automatically."
  echo "   Advanced users can instead point VESPA_ROOT at a system installation."
  echo ""
  echo "========================================================================"
  echo ""
}

# --- Check for CGAL ---
CGAL_INC=""
if [ -f /usr/include/CGAL/config.h ]; then
  CGAL_INC="/usr/include"
elif [ -f /usr/local/include/CGAL/config.h ]; then
  CGAL_INC="/usr/local/include"
elif [ -f /opt/homebrew/include/CGAL/config.h ]; then
  CGAL_INC="/opt/homebrew/include"
elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists cgal; then
  CGAL_INC=$(pkg-config --cflags-only-I cgal | sed 's/-I//g' | awk '{print $1}')
fi

if [ -z "$CGAL_INC" ]; then
  echo ">> Checking for CGAL... FAILED."
  print_install_instructions
  exit 1
fi
echo ">> Checking for CGAL... OK (found in $CGAL_INC)"

# --- Check for Eigen (required by CGAL and by the Vespa sources) ---
EIGEN_CPPFLAGS=""
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists eigen3 2>/dev/null; then
  EIGEN_CPPFLAGS=$(pkg-config --cflags eigen3)
elif [ -f /usr/include/eigen3/Eigen/Core ]; then
  EIGEN_CPPFLAGS="-I/usr/include/eigen3"
elif [ -f /usr/local/include/eigen3/Eigen/Core ]; then
  EIGEN_CPPFLAGS="-I/usr/local/include/eigen3"
elif [ -f /opt/homebrew/include/eigen3/Eigen/Core ]; then
  EIGEN_CPPFLAGS="-I/opt/homebrew/include/eigen3"
fi

if [ -z "$EIGEN_CPPFLAGS" ]; then
  echo ">> Checking for Eigen... FAILED."
  print_install_instructions
  exit 1
fi
echo ">> Checking for Eigen... OK"

# --- VTK is provided at install time by the rvtk package ----------------------
# VTK compiler and linker flags are resolved lazily by make via
# tools/configure.R (rvtk::CppFlags / rvtk::LdFlagsFile).  Consequently neither
# R CMD build nor this configure script needs VTK, network access, or the rvtk
# package to be installed yet: rvtk is an Imports dependency and is present when
# R CMD INSTALL compiles the sources.
VTK_ROOT="${VTK_ROOT:-}"

# --- Check for Ceres Solver ---
CERES_CFLAGS=""
CERES_LIBS=""

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ceres 2>/dev/null; then
  CERES_CFLAGS=$(pkg-config --cflags ceres)
  CERES_LIBS=$(pkg-config --libs ceres)
  echo ">> Found Ceres via pkg-config"
else
  CERES_INC=""
  CERES_LIBDIR=""

  for inc_dir in /usr/include /usr/local/include /opt/homebrew/include; do
    if [ -f "$inc_dir/ceres/ceres.h" ]; then
      CERES_INC="$inc_dir"
      CERES_CFLAGS="-I$inc_dir"
      break
    fi
  done

  for lib_dir in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib /usr/local/lib /opt/homebrew/lib; do
    if ls $lib_dir/libceres.* >/dev/null 2>&1; then
      CERES_LIBDIR="$lib_dir"
      CERES_LIBS="-L$lib_dir -lceres"
      break
    fi
  done

  if [ -n "$CERES_INC" ] && [ -n "$CERES_LIBDIR" ]; then
    echo ">> Found Ceres in standard paths"
  fi
fi

if [ -z "$CERES_LIBS" ]; then
  echo ">> Checking for Ceres Solver... FAILED."
  print_install_instructions
  exit 1
fi
echo ">> Checking for Ceres Solver... OK"

# --- Check for Vespa ---
VESPA_INC=""
VESPA_LIBDIR=""
VESPA_SOURCE=""

# --- Helpers for Vespa detection ---------------------------------------------
# has_real_archive DIR: succeed if DIR holds at least one libvtkCGAL*.a that
# is NOT a Windows import library (*.dll.a). *.dll.a files are PE/COFF import
# archives left over from a Windows build; feeding them to a Unix linker
# fails or silently produces a broken vespa.so.
has_real_archive() {
  for f in "$1"/libvtkCGAL*.a; do
    [ -e "$f" ] || continue
    case "$f" in *.dll.a) continue ;; esac
    return 0
  done
  return 1
}

# vespa_include_dir ROOT: print the include directory that holds the real
# vtkCGAL headers, or print nothing. The Kitware vespa project does NOT ship
# a vtkCGALAlgorithm.h; the stable flat headers are vtkCGALPolyDataAlgorithm.h
# (base class of every filter) and vtkCGALHelper.h. One-level-deep versioned
# layouts (include/vespa-0.5/) are accepted too. Always returns 0 so callers
# test the output with [ -n ] (configure.win runs under set -e).
vespa_include_dir() {
  if [ -f "$1/include/vtkCGALPolyDataAlgorithm.h" ] || \
     [ -f "$1/include/vtkCGALHelper.h" ]; then
    echo "$1/include"
  else
    for h in "$1"/include/*/vtkCGALPolyDataAlgorithm.h \
             "$1"/include/*/vtkCGALHelper.h; do
      [ -e "$h" ] || continue
      echo "${h%/*}"
      break
    done
  fi
  return 0
}

# Priority 1: bundled libs (Unix only) -- static (.a) or shared (.so/.dylib)
if [ -d "inst/vespa/include" ] && [ -d "inst/vespa/lib" ] && {
     has_real_archive inst/vespa/lib                    ||
     ls inst/vespa/lib/libvtkCGALAlgorithm*.so    >/dev/null 2>&1 ||
     ls inst/vespa/lib/libvtkCGALAlgorithm*.dylib >/dev/null 2>&1
   }; then
  VESPA_ROOT="$(pwd)/inst/vespa"
  VESPA_INC="$(vespa_include_dir "$VESPA_ROOT")"
  VESPA_LIBDIR="$VESPA_ROOT/lib"
  VESPA_SOURCE="bundled"
  echo ">> Checking for Vespa... OK (Unix bundle in inst/vespa)"
fi

# Priority 2: system installation (VESPA_ROOT first, then standard prefixes)
if [ -z "$VESPA_LIBDIR" ]; then
  if [ -n "$VESPA_ROOT" ]; then
    VESPA_CANDIDATES="$VESPA_ROOT"
  else
    VESPA_CANDIDATES="/usr/local /opt/vespa $HOME/vespa /opt/homebrew /usr"
  fi
  for d in $VESPA_CANDIDATES; do
    # Header marker: flat include/ first, then one level deep
    # (e.g. include/vespa-0.5/ style layouts). Uses the real header names
    # installed by the Kitware project (see vespa_include_dir above).
    _INC="$(vespa_include_dir "$d")"
    [ -n "$_INC" ] || continue
    if [ -d "$d/lib" ] && { has_real_archive "$d/lib" ||
         ls $d/lib/libvtkCGAL*.so >/dev/null 2>&1 ||
         ls $d/lib/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
      VESPA_LIBDIR="$d/lib"
    elif [ -d "$d/lib64" ] && { has_real_archive "$d/lib64" ||
         ls $d/lib64/libvtkCGAL*.so >/dev/null 2>&1 ||
         ls $d/lib64/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
      VESPA_LIBDIR="$d/lib64"
    else
      continue
    fi
    VESPA_ROOT="$d"
    VESPA_INC="$_INC"
    VESPA_SOURCE="system"
    break
  done
  if [ -n "$VESPA_LIBDIR" ]; then
    echo ">> Checking for Vespa... OK (system install in $VESPA_ROOT)"
  fi
fi

# Priority 3: vendored sources (always available, no network access needed).
VESPA_VENDORED=false
if [ -z "$VESPA_LIBDIR" ]; then
  if [ -d "tools/vespa-src/vespa" ]; then
    VESPA_SOURCE="vendored"
    VESPA_VENDORED=true
    VESPA_ROOT="$(pwd)/tools/vespa-src"
    VESPA_INC=""
    echo ">> Checking for Vespa... OK (vendored sources in tools/vespa-src)"
  fi
fi

if [ "$VESPA_VENDORED" = "false" ] && { [ -z "$VESPA_LIBDIR" ] || [ -z "$VESPA_INC" ]; }; then
  echo ">> Checking for Vespa... FAILED."
  echo ">> Diagnostics dump:"
  echo ">>   pwd        = $(pwd)"
  echo ">>   VESPA_ROOT = '${VESPA_ROOT}'"
  if [ -n "$VESPA_ROOT" ] && [ -d "$VESPA_ROOT" ]; then
    echo ">>   --- contents of ${VESPA_ROOT} ---"
    ls -la "$VESPA_ROOT"
    if [ -d "$VESPA_ROOT/include" ]; then
      echo ">>   --- contents of ${VESPA_ROOT}/include ---"
      ls "$VESPA_ROOT/include"
    else
      echo ">>   (no include/ subdirectory under VESPA_ROOT)"
    fi
    if [ -d "$VESPA_ROOT/lib" ]; then
      echo ">>   --- contents of ${VESPA_ROOT}/lib ---"
      ls "$VESPA_ROOT/lib"
    else
      echo ">>   (no lib/ subdirectory under VESPA_ROOT)"
    fi
  else
    echo ">>   VESPA_ROOT is empty or does not exist."
  fi
  print_install_instructions
  exit 1
fi

# --- Include paths and libraries for Vespa ---
if [ "$VESPA_VENDORED" = "true" ]; then
  VESPA_CPPFLAGS="-I../tools/vespa-src/vespa/Algorithm -I../tools/vespa-src/vespa/Delaunay -I../tools/vespa-src/vespa/PointSetProcessing -I../tools/vespa-src/vespa/PolygonMeshProcessing -I../tools/vespa-src/vespa/ShapeReconstruction -I../tools/vespa-src/module-headers"
  VESPA_STATIC=false
  VESPA_LIBS=""
  echo ">> Vespa: compiled from vendored sources"
else
  VESPA_CPPFLAGS="-I${VESPA_INC}"
  VESPA_STATIC=false
  VESPA_LIBS=""
  for f in "$VESPA_LIBDIR"/libvtkCGAL*.a; do
    [ -e "$f" ] || continue
    case "$f" in
      *.dll.a) continue ;;  # Windows import library: unusable on Unix
    esac
    VESPA_STATIC=true
    VESPA_LIBS="$VESPA_LIBS $f"
  done
  if [ "$VESPA_STATIC" = "true" ]; then
    echo ">> Vespa: static libraries"
  else
    for f in "$VESPA_LIBDIR"/libvtkCGAL*.so "$VESPA_LIBDIR"/libvtkCGAL*.dylib; do
      [ -e "$f" ] || continue
      n="${f##*/}"
      case "$n" in
        *.dylib) n="${n#lib}"; n="${n%.dylib}" ;;
        *.so)    n="${n#lib}"; n="${n%.so}" ;;
      esac
      VESPA_LIBS="$VESPA_LIBS -l$n"
    done
  fi
fi

# --- RPATH (not needed when everything is static) ---
RPATH_FLAG=""
if [ "$VESPA_STATIC" = "false" ] && [ "$VESPA_VENDORED" != "true" ]; then
  if [ "$VESPA_SOURCE" = "system" ]; then
    RPATH_FLAG="-Wl,-rpath,${VESPA_LIBDIR}"
  else
    RPATH_FLAG='-Wl,-rpath,$(R_PACKAGE_DIR)/vespa/lib'
  fi
fi

# --- VTK flags (resolved at install time by rvtk) -----------------------------
# Single quotes are intentional: make must receive the literal command
# substitution and run it when R CMD INSTALL compiles the package.  Running it
# here would require rvtk during R CMD build, which is not guaranteed.
VTK_CPPFLAGS='`"$(R_HOME)/bin/Rscript" ../tools/configure.R --cppflags`'
VTK_LIBS='`"$(R_HOME)/bin/Rscript" ../tools/configure.R --libs`'
VTK_ARCHIVES=""
GROUP_OPEN=""; GROUP_CLOSE=""; VTK_SYSLIBS=""
STRIP_LDFLAGS=""
case "$(uname -s)" in
  Linux*)
    GROUP_OPEN="-Wl,--start-group"; GROUP_CLOSE="-Wl,--end-group"
    VTK_SYSLIBS="-lpthread -ldl -lm -lz"
    STRIP_LDFLAGS="-Wl,-s"
    ;;
  Darwin*)
    VTK_SYSLIBS="-lz"
    STRIP_LDFLAGS="-Wl,-S"
    ;;
esac

# --- glog, if present (ceres may pull symbols from it) ---
GLOG_LIBS=""
for l in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib /usr/local/lib /opt/homebrew/lib; do
  if ls $l/libglog.* >/dev/null 2>&1; then GLOG_LIBS="-lglog"; break; fi
done

GLOG_CPPFLAGS=""
GLOG_HEADER=""
for h in /usr/include/glog/logging.h /usr/local/include/glog/logging.h /opt/homebrew/include/glog/logging.h; do
  if [ -f "$h" ]; then
    GLOG_HEADER="$h"
    break
  fi
done
if [ -n "$GLOG_HEADER" ] && grep -q "was not included correctly" "$GLOG_HEADER"; then
  GLOG_INCDIR="${GLOG_HEADER%/glog/logging.h}"
  GLOG_CPPFLAGS="-I${GLOG_INCDIR} -DGLOG_USE_GLOG_EXPORT -include glog/logging.h"
fi

EXPORT_FLAGS="-DVTKCGALALGORITHM_EXPORT= -DVTKCGALPMP_EXPORT= -DVTKCGALPSP_EXPORT= -DVTKCGALSR_EXPORT= -DVTKCGALDELAUNAY_EXPORT="

# --- Symbol localization (v8) ------------------------------------------------
# vespa.so embeds a full STATIC VTK plus the static vtkCGAL filters. On ELF,
# R loads every package with RTLD_GLOBAL, so ALL exported vespa.so symbols
# share the flat process namespace with rvtk.so (own static VTK). A version
# script keeps every symbol local except the single R entry point -- this is
# what --exclude-libs,ALL alone could not do (wrapper-object symbols).
# Relative paths are correct: make runs from src/ at link time.
SYMBOL_FLAGS=""
case "$(uname -s)" in
  Linux*)
    cat > src/vespa-symbols.map <<'MAP'
{
  global:
    R_init_vespa;
  local:
    *;
};
MAP
    SYMBOL_FLAGS="-Wl,--version-script=vespa-symbols.map"
    echo ">> Symbol localization: version script (only R_init_vespa exported)"
    ;;
  Darwin*)
    # Two-level namespace already prevents most interposition, but weak
    # symbols (typeinfo/vtables) are still coalesced across images: keep
    # vespa's internals fully private as well.
    cat > src/vespa-symbols.exp <<'EXP'
_R_init_vespa
EXP
    SYMBOL_FLAGS="-Wl,-exported_symbols_list,vespa-symbols.exp"
    echo ">> Symbol localization: exported symbols list (only R_init_vespa exported)"
    ;;
esac

echo ">> Generating src/Makevars..."
cat > src/Makevars <<EOF
# Generated by configure (vendored-vespa) -- do not edit.
CXX_STD = CXX17
CXXFLAGS += -g0
PKG_CPPFLAGS = ${GLOG_CPPFLAGS} ${VTK_CPPFLAGS} ${VESPA_CPPFLAGS} ${EIGEN_CPPFLAGS} -I${CGAL_INC} ${CERES_CFLAGS} ${EXPORT_FLAGS} -DCGAL_NDEBUG
PKG_LIBS = ${GROUP_OPEN} ${VESPA_LIBS} ${GROUP_CLOSE} ${VTK_LIBS} ${VTK_SYSLIBS} ${CERES_LIBS} ${GLOG_LIBS} -lgmp -lmpfr ${RPATH_FLAG} ${SYMBOL_FLAGS} ${STRIP_LDFLAGS}
EOF

echo ">> Configuration completed successfully."
exit 0
