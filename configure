#!/bin/sh
# configure -- Unix/macOS configuration for the vespa R package.
# Revision: tarball-static-v6
#  - FIX 2026-10-24 (real local R CMD check, Ubuntu/GCC 13): the header
#    marker vtkCGALAlgorithm.h does NOT exist in the Kitware vespa install
#    layout. The superbuild installs FLAT headers -- vtkCGALPolyDataAlgorithm.h
#    (base class of every filter), vtkCGALHelper.h -- plus per-module headers
#    such as vtkCGALAlgorithmModule.h. A successful auto-build was therefore
#    rejected by its own post-build re-check (VESPA_INC stayed empty).
#    Detection now uses vtkCGALPolyDataAlgorithm.h / vtkCGALHelper.h, flat
#    or one level deep.
#  - FIX: Priority 1 (bundled inst/vespa) accepts STATIC archives too (the
#    whole strategy is static), not just .so/.dylib.
#  - FIX: *.dll.a Windows import libraries are ignored everywhere (a stale
#    Windows bundle extracted into inst/vespa must not poison a Unix build).
#  - FIX: auto_build_vespa wipes inst/vespa before building so stale zips,
#    old *.dll.a or partial installs cannot poison the post-build check.
#  - FIX: removed the two lines that overwrote VTK_CPPFLAGS/VTK_LIBS with
#    inst/vtk paths that do not exist in CI.
#  - FIX: Strategy 2 (download) now sets VTK_INCDIR/VTK_LIBDIR.
#  - FIX: auto_build_vespa passes VTK_ROOT to the superbuild and stays
#    static (the superbuild requires VTK_ROOT; -DBUILD_SHARED_LIBS=ON
#    alone would hit a CMake FATAL_ERROR).
#  - FIX: Vespa detection hardened: the header marker is searched FLAT
#    (include/) AND one level deep (include/*/), lib/ and lib64/ both
#    accepted. The exact install layout of the Kitware vespa project has
#    never been exercised in CI before, so detection must not depend on a
#    single guess.
#  - FIX: full diagnostics dumped when Vespa is still not found.

print_install_instructions() {
  echo ""
  echo "========================================================================"
  echo " ERROR: Missing system dependencies for Vespa R package"
  echo "========================================================================"
  echo ""
  echo "This package requires CGAL, Ceres Solver, and the Vespa library."
  echo "VTK will be downloaded automatically if not found."
  echo ""
  echo "1. CGAL and Ceres can be installed via your package manager:"

  if [ "$(uname)" = "Darwin" ]; then
    echo "   On macOS (using Homebrew):"
    echo "     brew install cgal ceres-solver"
  elif [ -f /etc/debian_version ] || grep -qi "ubuntu" /etc/issue; then
    echo "   On Debian / Ubuntu:"
    echo "     sudo apt-get update"
    echo "     sudo apt-get install libcgal-dev libceres-dev"
  elif [ -f /etc/redhat-release ] || [ -f /etc/fedora-release ]; then
    echo "   On Fedora / RHEL / CentOS:"
    echo "     sudo dnf install CGAL-devel ceres-solver-devel"
  else
    echo "   On Linux, install the development packages for CGAL and Ceres."
  fi

  echo ""
  echo "2. Vespa is NOT distributed via standard package managers and must be"
  echo "   built from source using CMake. Please follow the instructions at:"
  echo "   https://gitlab.kitware.com/vtk/meshing/vespa"
  echo ""
  echo "   Once installed, ensure the configure script can find it by setting"
  echo "   the VESPA_ROOT environment variable before running R CMD INSTALL:"
  echo "     VESPA_ROOT=/path/to/vespa R CMD INSTALL ."
  echo ""
  echo "========================================================================"
  echo ""
}

# --- Check for CGAL ---
CGAL_INC=""
if [ -f /usr/include/CGAL/config.h ]; then
  CGAL_INC="/usr/include"
elif [ -f /usr/local/include/CGAL/config.h ]; then
  CGAL_INC="/usr/local/include"
elif [ -f /opt/homebrew/include/CGAL/config.h ]; then
  CGAL_INC="/opt/homebrew/include"
elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists cgal; then
  CGAL_INC=$(pkg-config --cflags-only-I cgal | sed 's/-I//g' | awk '{print $1}')
fi

if [ -z "$CGAL_INC" ]; then
  echo ">> Checking for CGAL... FAILED."
  print_install_instructions
  exit 1
fi
echo ">> Checking for CGAL... OK (found in $CGAL_INC)"

# --- Check for VTK (prebuilt tarball only, no system VTK) ---
VTK_FOUND=false
VTK_SOURCE=""
VTK_INCDIR=""
VTK_LIBDIR=""

# Strategy 0: prebuilt prefix via VTK_ROOT (CI or manual install)
if [ -n "$VTK_ROOT" ] && [ -d "$VTK_ROOT/include" ]; then
  for d in "$VTK_ROOT"/include/vtk-*; do
    if [ -f "$d/vtkObject.h" ]; then
      VTK_INCDIR="$d"; VTK_LIBDIR="$VTK_ROOT/lib"
      VTK_VERSION="$(basename "$d" | sed 's/^vtk-//')"
      VTK_FOUND=true; VTK_SOURCE="prebuilt"
      echo ">> Checking for VTK... OK (prebuilt in $VTK_ROOT)"
      break
    fi
  done
fi

# Strategy 1: System VTK via pkg-config (monolithic package is fine)
if command -v pkg-config >/dev/null 2>&1; then
  for vtk_pkg in vtk-9.7 vtk-9.6 vtk-9.5 vtk-9.4 vtk-9.3 vtk-9.2 vtk-9.1 vtk; do
    if pkg-config --exists "$vtk_pkg" 2>/dev/null; then
      VTK_VERSION=$(pkg-config --modversion "$vtk_pkg")
      VTK_FOUND=true
      VTK_SOURCE="system"
      VTK_PKG="$vtk_pkg"
      echo ">> Checking for VTK... OK (system VTK $VTK_VERSION)"
      break
    fi
  done
fi

# Strategy 2: Download prebuilt VTK from GitHub releases
if [ "$VTK_FOUND" = "false" ]; then
  VTK_VERSION="9.6.2"
  VTK_MINOR="${VTK_VERSION%.*}"

  OS=$(uname -s)
  ARCH=$(uname -m)
  case "$OS" in
    Linux*)
      if [ "$ARCH" = "x86_64" ]; then
        PLATFORM="linux-x86_64"
      elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
        PLATFORM="linux-aarch64"
      fi
      ;;
    Darwin*)
      if [ "$ARCH" = "arm64" ]; then
        PLATFORM="darwin-arm64"
      else
        PLATFORM="darwin-x86_64"
      fi
      ;;
  esac

  if [ -n "$PLATFORM" ]; then
    GITHUB_REPO="${GITHUB_REPOSITORY:-cregouby/vespa}"
    VTK_URL="https://github.com/${GITHUB_REPO}/releases/download/vtk-for-vespa-${VTK_VERSION}/vtk-${VTK_VERSION}-vespa-${PLATFORM}.tar.gz"

    echo ">> Downloading VTK $VTK_VERSION from $VTK_URL"
    if curl -fsSL "$VTK_URL" -o vtk-vespa.tar.gz 2>/dev/null; then
      mkdir -p inst/vtk
      tar -xzf vtk-vespa.tar.gz -C inst/vtk --strip-components=1
      rm vtk-vespa.tar.gz
      VTK_INCDIR="$(pwd)/inst/vtk/include/vtk-${VTK_MINOR}"
      VTK_LIBDIR="$(pwd)/inst/vtk/lib"
      if [ -f "$VTK_INCDIR/vtkObject.h" ] && ls "$VTK_LIBDIR"/libvtk*.a >/dev/null 2>&1; then
        VTK_FOUND=true
        VTK_SOURCE="downloaded"
        echo ">> VTK downloaded and extracted to inst/vtk"
      else
        echo ">> ERROR: incomplete VTK tarball (missing vtkObject.h or libvtk*.a)"
      fi
    else
      echo ">> ERROR: Failed to download VTK from $VTK_URL"
    fi
  fi
fi

if [ "$VTK_FOUND" = "false" ]; then
  echo ">> Checking for VTK... FAILED."
  echo "   Could not download prebuilt VTK."
  exit 1
fi

# --- Check for Ceres Solver ---
CERES_CFLAGS=""
CERES_LIBS=""

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ceres 2>/dev/null; then
  CERES_CFLAGS=$(pkg-config --cflags ceres)
  CERES_LIBS=$(pkg-config --libs ceres)
  echo ">> Found Ceres via pkg-config"
else
  CERES_INC=""
  CERES_LIBDIR=""

  for inc_dir in /usr/include /usr/local/include /opt/homebrew/include; do
    if [ -f "$inc_dir/ceres/ceres.h" ]; then
      CERES_INC="$inc_dir"
      CERES_CFLAGS="-I$inc_dir"
      break
    fi
  done

  for lib_dir in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib /usr/local/lib /opt/homebrew/lib; do
    if ls $lib_dir/libceres.* >/dev/null 2>&1; then
      CERES_LIBDIR="$lib_dir"
      CERES_LIBS="-L$lib_dir -lceres"
      break
    fi
  done

  if [ -n "$CERES_INC" ] && [ -n "$CERES_LIBDIR" ]; then
    echo ">> Found Ceres in standard paths"
  fi
fi

if [ -z "$CERES_LIBS" ]; then
  echo ">> Checking for Ceres Solver... FAILED."
  print_install_instructions
  exit 1
fi
echo ">> Checking for Ceres Solver... OK"

# --- Check for Vespa ---
VESPA_INC=""
VESPA_LIBDIR=""
VESPA_SOURCE=""

# --- Helpers for Vespa detection ---------------------------------------------
# has_real_archive DIR: succeed if DIR holds at least one libvtkCGAL*.a that
# is NOT a Windows import library (*.dll.a). *.dll.a files are PE/COFF import
# archives left over from a Windows build; feeding them to a Unix linker
# fails or silently produces a broken vespa.so.
has_real_archive() {
  for f in "$1"/libvtkCGAL*.a; do
    [ -e "$f" ] || continue
    case "$f" in *.dll.a) continue ;; esac
    return 0
  done
  return 1
}

# vespa_include_dir ROOT: print the include directory that holds the real
# vtkCGAL headers, or print nothing. The Kitware vespa project does NOT ship
# a vtkCGALAlgorithm.h; the stable flat headers are vtkCGALPolyDataAlgorithm.h
# (base class of every filter) and vtkCGALHelper.h. One-level-deep versioned
# layouts (include/vespa-0.5/) are accepted too. Always returns 0 so callers
# test the output with [ -n ] (configure.win runs under set -e).
vespa_include_dir() {
  if [ -f "$1/include/vtkCGALPolyDataAlgorithm.h" ] || \
     [ -f "$1/include/vtkCGALHelper.h" ]; then
    echo "$1/include"
  else
    for h in "$1"/include/*/vtkCGALPolyDataAlgorithm.h \
             "$1"/include/*/vtkCGALHelper.h; do
      [ -e "$h" ] || continue
      echo "${h%/*}"
      break
    done
  fi
  return 0
}

# Priority 1: bundled libs (Unix only) -- static (.a) or shared (.so/.dylib)
if [ -d "inst/vespa/include" ] && [ -d "inst/vespa/lib" ] && {
     has_real_archive inst/vespa/lib                    ||
     ls inst/vespa/lib/libvtkCGALAlgorithm*.so    >/dev/null 2>&1 ||
     ls inst/vespa/lib/libvtkCGALAlgorithm*.dylib >/dev/null 2>&1
   }; then
  VESPA_ROOT="$(pwd)/inst/vespa"
  VESPA_INC="$(vespa_include_dir "$VESPA_ROOT")"
  VESPA_LIBDIR="$VESPA_ROOT/lib"
  VESPA_SOURCE="bundled"
  echo ">> Checking for Vespa... OK (Unix bundle in inst/vespa)"
fi

# Priority 2: system installation (VESPA_ROOT first, then standard prefixes)
if [ -z "$VESPA_LIBDIR" ]; then
  if [ -n "$VESPA_ROOT" ]; then
    VESPA_CANDIDATES="$VESPA_ROOT"
  else
    VESPA_CANDIDATES="/usr/local /opt/vespa $HOME/vespa /opt/homebrew /usr"
  fi
  for d in $VESPA_CANDIDATES; do
    # Header marker: flat include/ first, then one level deep
    # (e.g. include/vespa-0.5/ style layouts). Uses the real header names
    # installed by the Kitware project (see vespa_include_dir above).
    _INC="$(vespa_include_dir "$d")"
    [ -n "$_INC" ] || continue
    if [ -d "$d/lib" ] && { has_real_archive "$d/lib" ||
         ls $d/lib/libvtkCGAL*.so >/dev/null 2>&1 ||
         ls $d/lib/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
      VESPA_LIBDIR="$d/lib"
    elif [ -d "$d/lib64" ] && { has_real_archive "$d/lib64" ||
         ls $d/lib64/libvtkCGAL*.so >/dev/null 2>&1 ||
         ls $d/lib64/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
      VESPA_LIBDIR="$d/lib64"
    else
      continue
    fi
    VESPA_ROOT="$d"
    VESPA_INC="$_INC"
    VESPA_SOURCE="system"
    break
  done
  if [ -n "$VESPA_LIBDIR" ]; then
    echo ">> Checking for Vespa... OK (system install in $VESPA_ROOT)"
  fi
fi

# Priority 3: auto-build (static, against the downloaded VTK tarball or the
# VTK_ROOT prefix; the superbuild requires VTK_ROOT).
auto_build_vespa() {
  AUTOBUILD_VTK_ROOT="$1"
  PKG_SRC="$(pwd)"
  INST_DIR="${PKG_SRC}/inst/vespa"
  BUILD_DIR="$(mktemp -d)"

  echo ">> Vespa not found on the system."
  echo ">> Attempting automatic build into ${INST_DIR} ..."

  # Wipe any stale bundle first: leftover Windows import libraries (*.dll.a),
  # old release zips or a partial install would poison the post-build
  # re-check (and R CMD build would ship megabytes of junk inside inst/).
  rm -rf "$INST_DIR"

  if ! command -v cmake >/dev/null 2>&1; then
    echo ">> cmake is required for automatic Vespa build but was not found."
    return 1
  fi
  if ! command -v git >/dev/null 2>&1; then
    echo ">> git is required for automatic Vespa build but was not found."
    return 1
  fi

  VESPA_GIT_TAG="v1.0"
  VERSION_FILE="${PKG_SRC}/.github/vespa-version.txt"
  if [ -f "$VERSION_FILE" ]; then
    VESPA_GIT_TAG="$(cat "$VERSION_FILE" | tr -d '[:space:]')"
  fi

  echo ">> Building Vespa ${VESPA_GIT_TAG} (static, against VTK in ${AUTOBUILD_VTK_ROOT}) ..."
  echo ">> (this may take several minutes) ..."

  cmake -S "${PKG_SRC}/tools/build-vespa" \
        -B "$BUILD_DIR" \
        -DINSTALL_PREFIX="$INST_DIR" \
        -DVESPA_GIT_TAG="$VESPA_GIT_TAG" \
        -DVTK_ROOT="$AUTOBUILD_VTK_ROOT" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build "$BUILD_DIR"

  STATUS=$?
  rm -rf "$BUILD_DIR"
  return $STATUS
}

if [ -z "$VESPA_LIBDIR" ]; then
  AUTOBUILD_VTK_ROOT=""
  if [ "$VTK_SOURCE" = "downloaded" ] && [ -d "$(pwd)/inst/vtk/lib" ]; then
    AUTOBUILD_VTK_ROOT="$(pwd)/inst/vtk"
  elif [ -n "$VTK_ROOT" ] && [ -d "$VTK_ROOT/lib" ]; then
    AUTOBUILD_VTK_ROOT="$VTK_ROOT"
  fi
  if [ -n "$AUTOBUILD_VTK_ROOT" ]; then
    if auto_build_vespa "$AUTOBUILD_VTK_ROOT"; then
      VESPA_SOURCE="autobuilt"
      VESPA_ROOT="$(pwd)/inst/vespa"
      VESPA_INC="$(vespa_include_dir "$VESPA_ROOT")"
      if [ -d "$VESPA_ROOT/lib" ] && { has_real_archive "$VESPA_ROOT/lib" ||
           ls "$VESPA_ROOT"/lib/libvtkCGAL*.so >/dev/null 2>&1 ||
           ls "$VESPA_ROOT"/lib/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
        VESPA_LIBDIR="$VESPA_ROOT/lib"
      elif [ -d "$VESPA_ROOT/lib64" ] && { has_real_archive "$VESPA_ROOT/lib64" ||
           ls "$VESPA_ROOT"/lib64/libvtkCGAL*.so >/dev/null 2>&1 ||
           ls "$VESPA_ROOT"/lib64/libvtkCGAL*.dylib >/dev/null 2>&1; }; then
        VESPA_LIBDIR="$VESPA_ROOT/lib64"
      fi
    fi
  else
    echo ">> Vespa not found and no usable static VTK for the auto-build."
  fi
fi

if [ -z "$VESPA_LIBDIR" ] || [ -z "$VESPA_INC" ]; then
  echo ">> Checking for Vespa... FAILED."
  echo ">> Diagnostics dump:"
  echo ">>   pwd        = $(pwd)"
  echo ">>   VESPA_ROOT = '${VESPA_ROOT}'"
  if [ -n "$VESPA_ROOT" ] && [ -d "$VESPA_ROOT" ]; then
    echo ">>   --- contents of ${VESPA_ROOT} ---"
    ls -la "$VESPA_ROOT"
    if [ -d "$VESPA_ROOT/include" ]; then
      echo ">>   --- contents of ${VESPA_ROOT}/include ---"
      ls "$VESPA_ROOT/include"
    else
      echo ">>   (no include/ subdirectory under VESPA_ROOT)"
    fi
    if [ -d "$VESPA_ROOT/lib" ]; then
      echo ">>   --- contents of ${VESPA_ROOT}/lib ---"
      ls "$VESPA_ROOT/lib"
    else
      echo ">>   (no lib/ subdirectory under VESPA_ROOT)"
    fi
  else
    echo ">>   VESPA_ROOT is empty or does not exist."
  fi
  print_install_instructions
  exit 1
fi

# --- Collect Vespa libraries (static or shared) ---
VESPA_STATIC=false
VESPA_LIBS=""
for f in "$VESPA_LIBDIR"/libvtkCGAL*.a; do
  [ -e "$f" ] || continue
  case "$f" in
    *.dll.a) continue ;;  # Windows import library: unusable on Unix
  esac
  VESPA_STATIC=true
  VESPA_LIBS="$VESPA_LIBS $f"
done
if [ "$VESPA_STATIC" = "true" ]; then
  echo ">> Vespa: static libraries"
else
  for f in "$VESPA_LIBDIR"/libvtkCGAL*.so "$VESPA_LIBDIR"/libvtkCGAL*.dylib; do
    [ -e "$f" ] || continue
    n="${f##*/}"
    case "$n" in
      *.dylib) n="${n#lib}"; n="${n%.dylib}" ;;
      *.so)    n="${n#lib}"; n="${n%.so}" ;;
    esac
    VESPA_LIBS="$VESPA_LIBS -l$n"
  done
fi

# --- RPATH (not needed when everything is static) ---
RPATH_FLAG=""
if [ "$VESPA_STATIC" = "false" ]; then
  if [ "$VESPA_SOURCE" = "system" ]; then
    RPATH_FLAG="-Wl,-rpath,${VESPA_LIBDIR}"
  else
    RPATH_FLAG='-Wl,-rpath,$(R_PACKAGE_DIR)/vespa/lib'
  fi
fi

# --- VTK flags ---
GROUP_OPEN=""; GROUP_CLOSE=""; VTK_SYSLIBS=""; VTK_ARCHIVES=""
if [ "$VTK_SOURCE" = "system" ]; then
  VTK_CPPFLAGS=$(pkg-config --cflags "$VTK_PKG")
  VTK_LIBS=$(pkg-config --libs "$VTK_PKG")
else
  # VTK_SOURCE = prebuilt (VTK_ROOT) or downloaded (inst/vtk):
  # VTK_INCDIR / VTK_LIBDIR were set by the matching strategy above.
  # -isystem: avoids the -Wpedantic spam from VTK headers (--as-cran warnings)
  VTK_CPPFLAGS="-isystem ${VTK_INCDIR}"
  for _a in "${VTK_LIBDIR}"/libvtk*.a; do
    [ -e "$_a" ] || continue
    VTK_ARCHIVES="$VTK_ARCHIVES $_a"
  done
  if [ -z "$VTK_ARCHIVES" ]; then
    echo ">> ERROR: no libvtk*.a found in ${VTK_LIBDIR} (incomplete VTK bundle?)"
    exit 1
  fi
  case "$(uname -s)" in
    Linux*)
      # GNU ld scans archives in a single pass: the group is MANDATORY,
      # otherwise alphabetical order != dependency order -> undefined references
      GROUP_OPEN="-Wl,--start-group"; GROUP_CLOSE="-Wl,--end-group"
      VTK_SYSLIBS="-lpthread -ldl -lm -lz"
      ;;
    Darwin*) VTK_SYSLIBS="-lz" ;;  # ld64 re-scans archives until a fixed point
  esac
fi

# --- glog, if present (ceres may pull symbols from it) ---
GLOG_LIBS=""
for l in /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib /usr/local/lib /opt/homebrew/lib; do
  if ls $l/libglog.* >/dev/null 2>&1; then GLOG_LIBS="-lglog"; break; fi
done

EXPORT_FLAGS="-DVTKCGALALGORITHM_EXPORT= -DVTKCGALPMP_EXPORT= -DVTKCGALPSP_EXPORT= -DVTKCGALSR_EXPORT= -DVTKCGALDELAUNAY_EXPORT="

echo ">> Generating src/Makevars..."
cat > src/Makevars <<EOF
# Generated by configure -- do not edit.
PKG_CPPFLAGS = ${VTK_CPPFLAGS} -I${VESPA_INC} -I${CGAL_INC} ${CERES_CFLAGS} ${EXPORT_FLAGS}
PKG_LIBS = ${GROUP_OPEN} ${VESPA_LIBS} ${VTK_ARCHIVES} ${GROUP_CLOSE} ${VTK_LIBS} ${VTK_SYSLIBS} ${CERES_LIBS} ${GLOG_LIBS} -lgmp -lmpfr ${RPATH_FLAG}
EOF

echo ">> Configuration completed successfully."
exit 0
